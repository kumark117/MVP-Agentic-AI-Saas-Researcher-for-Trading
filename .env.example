# AlloyIQ configuration (build prompt section 20).
# Copy to .env (scripts/dev.ps1 does this and generates random secrets).
# Defaults are dev/demo assumptions; the owner must confirm anything marked REAL.

APP_ENV=dev
PUBLIC_ORIGIN=http://localhost:8080

# --- PostgreSQL ---------------------------------------------------------------
# One password per role. docker-compose.yml builds DATABASE_URL,
# DATABASE_WORKER_URL and DATABASE_MIGRATOR_URL from these (see ADR-007), so
# each password is written only once.
POSTGRES_SUPERUSER_PASSWORD=change-me
ALLOYIQ_API_DB_PASSWORD=change-me
ALLOYIQ_WORKER_DB_PASSWORD=change-me
ALLOYIQ_MIGRATOR_DB_PASSWORD=change-me
# Host port for running tests from Windows against the compose database.
POSTGRES_HOST_PORT=5432

REDIS_URL=redis://redis:6379/0

# --- Email (Mailpit in dev) ---------------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=no-reply@alloyiq.local
# Hosted SMTP only (e.g. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, an app password).
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false

# --- Secrets ------------------------------------------------------------------
SESSION_SECRET=change-me                 # HMAC pseudonyms and signed links
MCP_URL=http://mcp:8100/mcp
# DV-15: in_process calls the tools directly (fallback); postgres keeps artifact bytes in the DB (Render).
TOOL_GATEWAY=mcp
ARTIFACT_BACKEND=local
MCP_SERVICE_TOKEN=change-me
# needed from P6 (live runs only with owner approval)
ANTHROPIC_API_KEY=
# optional; empty = local trace sink + gap flag
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=alloyiq-dev
# needed from P3 live adapter tests
ALPHAVANTAGE_API_KEY=
# needed from P3 live adapter tests
TAVILY_API_KEY=
ENABLE_YAHOO_REFERENCE=1                 # dev only; pre-launch licensing blocker
# live = real providers (needs the keys above). fixtures = SYNTHETIC data, clearly labelled,
# for trying the app without keys; refused when APP_ENV=prod.
PROVIDER_MODE=live
LLM_MODE=live                            # fake = synthetic model output for e2e only; refused in prod

# --- Real-money guards (REAL USD; the owner must confirm) ---------------------
REAL_SPEND_PER_RUN_USD=1.50
REAL_SPEND_ACCOUNT_DAY_USD=5.00
REAL_SPEND_PLATFORM_DAY_USD=20.00

# --- Demo assumptions (simulated INR; no monetary value) ----------------------
DEMO_FX_USD_INR=85.00                    # demo display assumption, NOT a market rate
DEMO_MARKUP=1.25
DEMO_OPENING_CREDIT_INR=500.00
DEMO_DAILY_TOPUP_LIMIT_INR=1000.00
DEMO_CHECKOUT_MAX_INR=500.00

LIVE_PROVIDER_TESTS=0
