{
  "additionalProperties": false,
  "description": "The JSON carried in an SSE `data:` field (D085).",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "event_id": {
      "pattern": "^[0-9a-f-]{36}:\\d+$",
      "title": "Event Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "attempt": {
          "title": "Attempt",
          "type": "integer"
        }
      },
      "required": [
        "node_id",
        "attempt"
      ],
      "title": "NodeStarted",
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "sequence",
    "occurred_at",
    "payload"
  ],
  "title": "run:node.started",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-sse-event": "node.started",
  "x-scope": "run"
}
