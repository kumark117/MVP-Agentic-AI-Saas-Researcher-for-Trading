{
  "additionalProperties": false,
  "description": "The JSON carried in an SSE `data:` field (D085).",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "event_id": {
      "pattern": "^[0-9a-f-]{36}:\\d+$",
      "title": "Event Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "queued",
            "running",
            "cancel_requested",
            "succeeded",
            "incomplete",
            "failed",
            "cancelled",
            "timed_out"
          ],
          "title": "Status",
          "type": "string"
        },
        "terminal_at": {
          "format": "date-time",
          "title": "Terminal At",
          "type": "string"
        },
        "report_available": {
          "title": "Report Available",
          "type": "boolean"
        },
        "billing_status": {
          "enum": [
            "reserved",
            "pending_settlement",
            "settled",
            "released",
            "disputed"
          ],
          "title": "Billing Status",
          "type": "string"
        },
        "outcome_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Outcome Reason"
        }
      },
      "required": [
        "status",
        "terminal_at",
        "report_available",
        "billing_status",
        "outcome_reason"
      ],
      "title": "RunFinished",
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "sequence",
    "occurred_at",
    "payload"
  ],
  "title": "run:run.finished",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-sse-event": "run.finished",
  "x-scope": "run"
}
