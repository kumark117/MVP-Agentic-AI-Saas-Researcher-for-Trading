{
  "additionalProperties": false,
  "description": "The JSON carried in an SSE `data:` field (D085).",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "event_id": {
      "pattern": "^[0-9a-f-]{36}:\\d+$",
      "title": "Event Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Agent"
        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "tool_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Name"
        },
        "summary": {
          "maxLength": 2000,
          "title": "Summary",
          "type": "string"
        },
        "elapsed_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elapsed Ms"
        },
        "retry": {
          "default": 0,
          "title": "Retry",
          "type": "integer"
        },
        "validation_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Status"
        }
      },
      "required": [
        "agent",
        "action",
        "summary"
      ],
      "title": "ActivityAppended",
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "sequence",
    "occurred_at",
    "payload"
  ],
  "title": "run:activity.appended",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-sse-event": "activity.appended",
  "x-scope": "run"
}
